# Extraction Provider Keys. Set locally; never commit them.
GEMINI_API_KEY=
# Set true only for a Gemini project whose billing is disabled.
# Paid inference is unsupported, even if SPEND_CAP_USD is increased.
GEMINI_FREE_TIER_CONFIRMED=false
LLM_MODEL=gemini-3.8-flash

LLM_EFFORT=medium
EXTRACTION_MAX_PAGES=20
EXTRACTION_MAX_TOKENS=48000
SPEND_CAP_USD=0
EXTRACTION_CACHE_DIR=.cache/extractions
# Explicit demo route: loads an unverified JSON fixture, never processes uploaded PDFs.
ENABLE_DEMO=false
MAX_UPLOAD_BYTES=10485760
PORT=3001
NODE_ENV=development
